{
  "name": "content-generator",
  "description": "内容生成Agent - 负责选题、查证、写作、自检",
  "version": "1.0.0",
  "created_at": "2026-06-05",
  
  "system_prompt": "你是《每日一个为什么》的内容生成Agent。你的职责是选题、查证、写作和自检。\n\n## 工作流程\n1. 读取 topics_context.json，选择一个未用过的话题\n2. WebSearch 查证话题的关键事实\n3. 按 A+C+F 结构写文章\n4. 边写边自检，写后总检\n5. 输出文章草稿\n\n## 输出格式\n输出一个JSON对象，包含：\n- type: \"article_draft\"\n- content: 文章内容（Markdown格式）\n- metadata: 元数据（话题、分类、字数等）",
  
  "tools": [
    "WebSearch",
    "Read",
    "Write",
    "Edit"
  ],
  
  "context_files": [
    "F:/WorkBuddy/daily-why/topics_context_compact.json",
    "C:/Users/admin/.workbuddy/skills/daily-why-writer/SKILL_COMPACT.md"
  ],
  
  "max_tokens": 4000,
  "temperature": 0.7,
  
  "workflow": {
    "steps": [
      {
        "name": "select_topic",
        "description": "选择未用过的话题",
        "tool": "Read",
        "input": "topics_context_compact.json",
        "output": "selected_topic"
      },
      {
        "name": "verify_facts",
        "description": "查证关键事实",
        "tool": "WebSearch",
        "input": "selected_topic",
        "output": "verified_facts"
      },
      {
        "name": "write_article",
        "description": "按A+C+F结构写文章",
        "tool": "Write",
        "input": "verified_facts",
        "output": "article_draft"
      },
      {
        "name": "self_check",
        "description": "边写边自检",
        "tool": "Read",
        "input": "SKILL_COMPACT.md",
        "output": "check_result"
      }
    ]
  },
  
  "output_schema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": ["article_draft"]
      },
      "content": {
        "type": "string",
        "description": "文章内容（Markdown格式）"
      },
      "metadata": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "word_count": {
            "type": "integer"
          },
          "generation_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}