{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dailywhy/publish_manifest.schema.json",
  "title": "dailywhy publish manifest contract v1",
  "description": "L3 每次发布写出一份，记录本次发布的输入、产物与校验结果。L3 报告渲染与后续审计都读它，不再从 Markdown 正则反推。",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "topic",
    "v1_path",
    "v2_path",
    "review_paths",
    "ima_note_id",
    "git_commit",
    "checks"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "topic": { "type": "string", "minLength": 1 },
    "v1_path": { "type": "string", "minLength": 1 },
    "v2_path": { "type": ["string", "null"] },
    "review_paths": { "type": "array", "items": { "type": "string" } },
    "ima_note_id": { "type": ["string", "null"] },
    "git_commit": { "type": ["string", "null"] },
    "char_count": { "type": ["integer", "null"], "minimum": 0 },
    "fixture": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "warn", "fail", "skip"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
