{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dailywhy/learning_summary.schema.json",
  "title": "dailywhy learning summary contract v1",
  "description": "L2 学习总结的机器交接契约。Markdown 只是渲染层，L3 读的是本结构；契约锚点为逐字 `## 改进点`。",
  "type": "object",
  "required": [
    "schema_version",
    "date",
    "article_id",
    "improvements",
    "new_rules",
    "rejected_suggestions",
    "source_files",
    "memory_update"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["v1"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "article_id": { "type": "string", "minLength": 8 },
    "title": { "type": "string" },
    "improvements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "dimension": { "type": "string" },
          "source_ai": { "type": "string" }
        }
      }
    },
    "new_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "rule_id": { "type": "string" }
        }
      }
    },
    "rejected_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "source_files": { "type": "array", "items": { "type": "string" } },
    "memory_update": {
      "type": "object",
      "description": "Phase 6 记忆更新的执行声明（11-10 建，2026-11-11 起生效；此前历史文件由 validate_contract.py 按效日豁免为 WAIV）。mode=append 表示本日有新教训并将追加 topics/lessons.md；mode=noop 表示无新教训，reason 必须说清判据。",
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "type": "string", "enum": ["append", "noop"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
